{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Obsidian Dark",
  "slug": "dark",
  "settings": {
    "custom": {
      "card-bg": "#1b2336",
      "card-bg-hover": "#252d40",
      "surface": {
        "canvas": "#0d0f12",
        "card": "#131720",
        "card-hover": "#171d29",
        "elevated": "#181e2b",
        "header": "rgba(13, 15, 18, 0.94)",
        "border": "rgba(255, 255, 255, 0.10)",
        "text": "#f8fafc",
        "muted": "rgba(255, 255, 255, 0.76)",
        "subtle": "#94a3b8"
      }
    }
  },
  "styles": {
    "color": {
      "background": "#0d0f12",
      "text": "#f8fafc"
    },
    "elements": {
      "link": {
        "color": {
          "text": "#86efac"
        },
        ":hover": {
          "color": {
            "text": "#34d399"
          }
        }
      },
      "h1": { "color": { "text": "#ffffff" } },
      "h2": { "color": { "text": "#ffffff" } },
      "h3": { "color": { "text": "#ffffff" } },
      "h4": { "color": { "text": "#ffffff" } },
      "h5": { "color": { "text": "#ffffff" } },
      "h6": { "color": { "text": "#ffffff" } },
      "button": {
        "color": {
          "background": "#22c55e",
          "text": "#052e16"
        },
        ":hover": {
          "color": {
            "background": "#4ade80"
          }
        }
      }
    },
    "blocks": {
      "core/navigation": {
        "color": {
          "text": "rgba(255, 255, 255, 0.82)"
        }
      },
      "core/site-title": {
        "color": {
          "text": "#ffffff"
        }
      },
      "core/code": {
        "color": {
          "background": "#0d1117",
          "text": "#f8fafc"
        }
      }
    }
  }
}
